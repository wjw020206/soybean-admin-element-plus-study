    "vue-i18n": "^11.4.4",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.481",
    "@iconify/vue": "^5.0.1",
    "@sa/scripts": "workspace:*",
    "@soybeanjs/eslint-config": "^1.7.5",
    "@types/node": "^25.9.1",
